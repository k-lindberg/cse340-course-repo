<%- include('partials/header') %>

    <main>
        <h1>
            <%= projectDetails.title %>
        </h1>
        
        <p><strong>Description:</strong>
            <%= projectDetails.description %>
        </p>
        
        <p><strong>Date:</strong>
            <%= new Date(projectDetails.project_date).toDateString() %>
        </p>
        
        <p><strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <p><strong>Category:</strong>
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            <% }); %>
        
        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>
    </main>

<%- include('partials/footer') %>