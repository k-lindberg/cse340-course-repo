<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.service_project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" required maxlength="150" value="<%= projectDetails.title %>" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="500"><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" required maxlength="255" value="<%= projectDetails.location %>" />
            </div>

            <div class="form-group">
                <label for="project_date">Project Date</label>
                <input type="date" id="project_date" name="project_date" required value="<%= new Date(projectDetails.project_date).toISOString().split('T')[0] %>" />
            </div>

            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>" <%= String(org.organization_id) === String(projectDetails.organization_id) ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>