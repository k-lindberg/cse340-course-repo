<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        
        <h2>Users</h2>

        <ul class="users-list">
            <% users.forEach(user=> { %>
                <li>
                    <strong>
                        <%= user.name %>
                    </strong>
                    <span>Email: <%= user.email %></span>
                    <span>Role: <%= user.role_name %></span>
                </li>
                <% }) %>
        </ul>

    </main>

    <%- include('partials/footer') %>