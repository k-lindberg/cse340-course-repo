<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2 class="organization-header">
        <%= organizationDetails.name %>
    </h2>
    
    <div class="organization-header">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
    </div>
    
    <p class="organization-description">
        Description: <%= organizationDetails.description %>
    </p>
    
    <h3>Service Projects</h3>
    <ul class="projects-list">
        <% projects.forEach(project=> { %>
            <li>
                <a href="/project/<%= project.service_project_id %>">
                    <%= project.title %>
                </a>
            </li>
            <% }); %>
    </ul>
    <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>

</main>
<%- include('partials/footer') %>